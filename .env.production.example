# Production API — set these in your host's environment (Node app, ECS, Elastic Beanstalk, etc.)
# Do NOT commit real secrets. Copy values into the platform env UI or a private .env.production file.

NODE_ENV=production
PORT=3000
DATABASE_TARGET=production

# Comma-separated browser origins allowed to call the API (your static frontend URL(s))
CORS_ORIGIN=https://powderblue-alligator-791855.hostingersite.com

# MySQL — on the same server as the API, use localhost (no ssl param).
# From a remote machine (CI, laptop), use the DB host + ?ssl=true if required.
DATABASE_URL_PRODUCTION=mysql://USER:URL_ENCODED_PASSWORD@localhost:3306/DATABASE_NAME

# Optional: set to false if your cloud MySQL uses a cert Node rejects (some managed DBs)
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── Email delivery (AWS SES) ──────────────────────────────────────────────
# Emails (invitations, Success Engine reminders, settlement notices) only SEND
# when both SES_FROM_EMAIL and AWS_REGION are set. Until then they are logged
# to the email_log table (visible in the admin email-log screen) but not sent.
#
# 1) Verify a sender identity (domain or email) in AWS SES.
# 2) Move the SES account out of the "sandbox" to email arbitrary recipients.
# 3) Create an IAM user/role with ses:SendEmail permission.
#
# The "from" address — MUST be a verified SES identity:
# SES_FROM_EMAIL=no-reply@yourdomain.com
# AWS region your SES identity lives in:
# AWS_REGION=us-east-1
# AWS credentials (omit if the host provides an IAM role instead):
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
#
# Public frontend base URL used to build links inside emails:
# FRONTEND_URL=https://yourdomain.com
